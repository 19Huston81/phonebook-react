<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    
    <!-- Правила перезаписи (проксирование + SPA) -->
    <rewrite>
      <rules>
        
        <!-- Правило 1: Проксирование /api/* на Node-сервер -->
        <rule name="Proxy API to Node" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:3001/api/{R:1}" />
        </rule>
        
        <!-- Правило 2: Все остальные запросы → на фронтенд -->
        <rule name="Frontend Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Если запрос НЕ к существующему файлу -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- И НЕ к существующей папке -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- Перенаправляем на index.html (для React Router) -->
          <action type="Rewrite" url="/index.html" />
        </rule>
        
      </rules>
    </rewrite>

    <!-- Настройка типов содержимого -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
    </staticContent>

    <!-- Указываем корневой документ -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Включаем сжатие для ускорения -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>
</configuration>